# ShiftCred backend selection (src/lib/shifts/backend.ts):
#   - Set both NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY to
#     use the real Supabase backend (supabase/migrations/20260927000000_shiftcred.sql).
#   - Otherwise, set NEXT_PUBLIC_HOURPROOF_BACKEND=mock to use the in-memory
#     mock backend (no Supabase project needed) for local dev and e2e.
#   - If neither is set, every ShiftCred call throws ShiftBackendError('unavailable').
#
# NEXT_PUBLIC_* vars are baked in at BUILD time, not read at request time —
# set them before `next build`, not just before `next start`.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_HOURPROOF_BACKEND=mock

# Enables the mock ShiftCred HTTP endpoint (src/app/api/mock-shifts/route.ts),
# which otherwise 404s. Also unlocks its e2e-only extras (the `reset` op and
# the x-hp-now time-travel header). Never set this in a real deployment.
HOURPROOF_MOCK_SHIFTS=
