{
  "name": "hourproof",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "postinstall": "ln -sf \"$npm_node_execpath\" node_modules/.bin/node",
    "prebuild": "vitest run src/lib/rules",
    "dev": "next dev -p 7050",
    "dev:mock": "HOURPROOF_MOCK_SHIFTS=1 next dev -p 7050",
    "build": "next build",
    "start": "next start -p 7050",
    "start:e2e": "next start -p 7051",
    "test": "vitest run",
    "test:sql": "vitest run test/sql",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "measure": "node scripts/measure-js.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "idb": "^8.0.3",
    "next": "^16.3.6",
    "next-intl": "^4.14.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
